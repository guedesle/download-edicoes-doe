{
  "manifest_version": 3,
  "name": "Download de Edições DOE",
  "description": "Inventário, downloads, consulta e analytics local das edições do EGBANET.",
  "version": "0.7.1",
  "version_name": "0.7.1",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "storage", "downloads", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["https://egbanet.egba.ba.gov.br/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download de Edições DOE · v0.7.1"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
